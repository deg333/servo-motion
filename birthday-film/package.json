{
  "name": "birthday-film",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "audio": "node scripts/make-audio.mjs",
    "render:video": "remotion render src/index.ts BirthdayFilm out/video12.mp4 --gl=swangle --concurrency=3 --timeout=300000 --crf=14 --muted",
    "finish": "bash scripts/finish.sh",
    "build": "npm run audio && npm run render:video && npm run finish",
    "still": "remotion still src/index.ts BirthdayFilm out/still.png --gl=swangle --frame=95"
  },
  "dependencies": {
    "@react-three/fiber": "8.17.10",
    "@remotion/cli": "4.0.250",
    "@remotion/three": "4.0.250",
    "@types/react": "18.3.12",
    "@types/three": "0.170.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.250",
    "three": "0.170.0",
    "typescript": "5.6.3"
  }
}
